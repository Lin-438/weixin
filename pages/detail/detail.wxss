.stat-row {
  text-align: center;
}

.stat {
  flex: 1;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
}

.stat-num.green {
  color: #1f9e55;
}

.stat-num.red {
  color: #9e1f19;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #5a6472;
  border-radius: 12rpx;
}

.tab.active {
  background: #9e1f19;
  color: #fff;
  font-weight: 600;
}

.member-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #ebedf0;
}

.member-row:last-child {
  border-bottom: none;
}

.member-main {
  flex: 1;
  min-width: 0;
}

.member-name {
  font-size: 30rpx;
  font-weight: 600;
}

.member-actions {
  display: flex;
  flex: none;
  margin-left: 16rpx;
}

.act {
  margin-left: 12rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #9e1f19;
  color: #fff;
  font-size: 24rpx;
}

.act.gray {
  background: #f1f2f4;
  color: #5a6472;
}

.act.danger {
  background: #fff;
  color: #9e1f19;
  border: 2rpx solid #9e1f19;
}

.mt8 {
  margin-top: 8rpx;
}

.tips {
  padding: 0 12rpx 40rpx;
  text-align: center;
}
