.member-main {
  flex: 1;
  min-width: 0;
}

.member-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-right: 12rpx;
}

.act {
  flex: none;
  margin-left: 16rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #9e1f19;
  color: #fff;
  font-size: 24rpx;
}

.act.gray {
  background: #f1f2f4;
  color: #5a6472;
}

.mt8 {
  margin-top: 8rpx;
}

.action-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f2f3f5;
}
