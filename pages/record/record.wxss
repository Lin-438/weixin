.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #5a6472;
  border-radius: 12rpx;
}

.tab.active {
  background: #9e1f19;
  color: #fff;
  font-weight: 600;
}

.session-main {
  flex: 1;
  min-width: 0;
}

.session-title {
  font-size: 30rpx;
  font-weight: 600;
}

.session-right {
  text-align: right;
  flex: none;
  margin-left: 16rpx;
}

.ratio {
  font-size: 34rpx;
  font-weight: 700;
  color: #9e1f19;
}

.slash {
  font-size: 24rpx;
  color: #8a8f99;
  font-weight: 400;
}

.bar {
  height: 10rpx;
  border-radius: 999rpx;
  background: #f1f2f4;
  overflow: hidden;
}

.bar-inner {
  height: 100%;
  background: linear-gradient(90deg, #9e1f19, #c8443c);
  border-radius: 999rpx;
}

.link {
  color: #9e1f19;
  font-size: 26rpx;
}

.mt8 {
  margin-top: 8rpx;
}

.mt16 {
  margin-top: 16rpx;
}
