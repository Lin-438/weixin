.wrap {
  padding: 60rpx 48rpx 60rpx;
}

.hero {
  text-align: center;
  padding: 40rpx 0 60rpx;
}

.badge {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #9e1f19, #c8443c);
  color: #f7dca0;
  font-size: 60rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(158, 31, 25, 0.28);
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 8rpx;
  color: #8a8f99;
  font-size: 26rpx;
}

.feature {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  color: #5a6472;
  font-size: 26rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #c9a063;
  margin-right: 16rpx;
  flex: none;
}

.tips {
  margin-top: 24rpx;
  text-align: center;
  color: #9e1f19;
  font-size: 26rpx;
}

.mt24 {
  margin-top: 24rpx;
}

.field-col {
  padding: 20rpx 0 8rpx;
}

.col-label {
  color: #5a6472;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.input {
  height: 88rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1f2329;
}
