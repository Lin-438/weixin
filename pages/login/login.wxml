<view class="wrap">
  <view class="hero">
    <view class="badge">队</view>
    <view class="hero-title">{{teamName}}</view>
    <view class="hero-sub">三校区日常训练签到</view>
  </view>

  <view class="card">
    <view class="feature">
      <view class="dot"></view>
      <text>校区管理员发起签到，生成动态二维码</text>
    </view>
    <view class="feature">
      <view class="dot"></view>
      <text>队员扫码并现场拍照，自动记录时间</text>
    </view>
    <view class="feature">
      <view class="dot"></view>
      <text>未签名单可手动补签，月底按校区导出出勤表</text>
    </view>
  </view>

  <block wx:if="{{stage === 'start'}}">
    <button class="btn btn-block" loading="{{loading}}" disabled="{{loading}}" bindtap="onLogin">
      微信一键登录
    </button>
    <view class="tips" wx:if="{{error}}">{{error}}</view>
    <view class="tips muted">登录后用姓名拼音 + 学号绑定本人身份，绑定一次即可</view>
  </block>

  <block wx:elif="{{stage === 'bind'}}">
    <view class="card">
      <view class="card-title">绑定本人身份</view>
      <view class="muted">账号是姓名拼音（如 张伟 → zhangwei），初始密码是本人学号</view>

      <view class="field-col">
        <view class="col-label">账号（姓名拼音）</view>
        <input
          class="input"
          placeholder="例如 zhangwei"
          value="{{login}}"
          bindinput="onInputLogin"
          confirm-type="next"
        />
      </view>

      <view class="field-col">
        <view class="col-label">密码（初始为学号）</view>
        <input
          class="input"
          placeholder="请输入学号"
          password="{{true}}"
          value="{{password}}"
          bindinput="onInputPassword"
          confirm-type="done"
          bindconfirm="onBind"
        />
      </view>

      <button class="btn btn-block mt24" loading="{{binding}}" disabled="{{binding}}" bindtap="onBind">
        绑定并进入
      </button>
      <view class="tips" wx:if="{{error}}">{{error}}</view>
      <view class="tips muted" bindtap="onSkip">账号不存在？请联系本校区管理员导入名单</view>
    </view>
  </block>
</view>
