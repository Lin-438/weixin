{
  "miniprogramRoot": "./",
  "compileType": "miniprogram",
  "appid": "touristappid",
  "projectname": "guard-checkin",
  "libVersion": "3.5.5",
  "setting": {
    "urlCheck": true,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "minifyWXSS": true,
    "minifyWXML": true,
    "coverView": true,
    "lazyloadPlaceholderEnable": false,
    "ignoreDevUnusedFiles": true,
    "checkInvalidKey": true,
    "showShadowRootInWxmlPanel": true,
    "packNpmManually": false,
    "packNpmRelationList": [],
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    },
    "useCompilerPlugins": []
  },
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "tests"
      },
      {
        "type": "file",
        "value": "package-lock.json"
      }
    ],
    "include": []
  },
  "condition": {}
}
